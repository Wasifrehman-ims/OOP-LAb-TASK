#include <iostream>
using namespace std;

class Car{
	public:
		string brand;
		int year ;
		
	void display(){
		cout<<"Car brand  : "<< brand << endl;
		cout<<"Model Year : "<< year << endl;
	}
};
int main(){
	Car c;
	Car c1;
	c.brand = "Toyata";
	c.year  = 2018;
	
	c1.brand = "BMW";
	c1.year  = 2022 ;
	
	c.display();
	c1.display();
	return 0;
}
